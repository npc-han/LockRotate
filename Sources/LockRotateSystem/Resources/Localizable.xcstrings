{
  "sourceLanguage": "en",
  "strings": {
    "system.error.helperNotInstalled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LockRotate isn't authorized yet. Authorize it in Settings first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有授权。请先在设置的「授权」页完成授权。"
          }
        }
      }
    },
    "system.error.rejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The helper rejected the text: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "helper 拒绝了这段文字：%@"
          }
        }
      }
    },
    "system.error.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation failed (exit code %lld): %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作失败（退出码 %lld）：%@"
          }
        }
      }
    },
    "system.error.timedOut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation timed out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作超时。"
          }
        }
      }
    },
    "system.error.userCancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrator authorization was cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消管理员授权。"
          }
        }
      }
    },
    "system.error.invalidUsername": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current user name cannot be used for installation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前用户名不能用于安装。"
          }
        }
      }
    },
    "system.error.resourceMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bundled file is missing: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少内置文件：%@"
          }
        }
      }
    }
  },
  "version": "1.0"
}